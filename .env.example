# ============================================================================
# CONCILIUM — environment configuration example
# Copy this file to ".env" and fill in the values you need.  Nothing here is
# required: Concilium boots out-of-the-box with the built-in MOCK provider so
# you can explore the UI, councils and workflows without any API key.
#
#   cp .env.example .env
#
# All settings are OPTIONAL.  API keys can ALSO be added later in the web UI
# (Settings -> Providers); keys entered there are encrypted at rest with
# CONCILIUM_SECRET_KEY (or an auto-generated key stored in ./data/secret.key).
# ============================================================================

# --- Core ------------------------------------------------------------------
# Secret used to sign auth tokens and (if set) encrypt credentials stored via
# the UI. Generate one with:  python -c "import secrets;print(secrets.token_hex(32))"
# If unset, a key is generated once and persisted in ./data/secret.key
CONCILIUM_SECRET_KEY=

# SQLite database location (default ./data/concilium.db). PostgreSQL also works:
# CONCILIUM_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/concilium
CONCILIUM_DATABASE_URL=sqlite+aiosqlite:///./data/concilium.db

# Directory for uploaded documents, generated artifacts and local state
CONCILIUM_DATA_DIR=./data

# Require a login password. Leave blank for open, single-user local mode.
# If you expose Concilium beyond localhost, SET THIS.
CONCILIUM_PASSWORD=

# Network
CONCILIUM_HOST=0.0.0.0
CONCILIUM_PORT=8000
CONCILIUM_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Provider API keys -----------------------------------------------------
# Each key is picked up automatically by the matching provider adapter.
# Keys are only ever used in SERVER-SIDE requests and are never sent to the
# browser (the API returns a "configured: true/false" boolean instead).

# OpenAI        https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional custom base URL (Azure-style gateways, proxies, etc.)
OPENAI_BASE_URL=

# Anthropic     https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google AI Studio (Gemini)  https://aistudio.google.com/app/apikey
# Gemini has a genuinely free tier (rate-limited) — great first remote key.
GOOGLE_API_KEY=

# Groq          https://console.groq.com/keys  (free developer tier, very fast)
GROQ_API_KEY=

# Mistral       https://console.mistral.ai/api-keys  (free tier available)
MISTRAL_API_KEY=

# Together AI   https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# OpenRouter    https://openrouter.ai/keys  (many ":free" models)
OPENROADER_API_KEY=

# xAI (Grok)    https://console.x.ai/
XAI_API_KEY=

# Cohere        https://dashboard.cohere.com/api-keys  (free trial keys)
COHERE_API_KEY=

# --- Local providers -------------------------------------------------------
# No keys required.  Leave defaults if you run the apps locally.
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Add any other OpenAI-compatible local server (llama.cpp, vLLM, LocalAI...)
# Multiple endpoints can be configured in the UI under Providers -> Add.
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=

# --- Tools -----------------------------------------------------------------
# Tavily web search (free tier): https://tavily.com/#api
TAVILY_API_KEY=
# Or point at your own SearXNG instance (public JSON API enabled):
SEARXNG_URL=

# --- Execution / safety ----------------------------------------------------
# Enable the (process-isolated, resource-limited) Python code-execution tool.
# Disabled by default. When enabled it runs in an isolated subprocess with
# CPU/memory/time limits; for strong isolation run Concilium in Docker.
CONCILIUM_ENABLE_PYTHON_SANDBOX=false
CONCILIUM_SANDBOX_TIMEOUT=8
CONCILIUM_SANDBOX_MEMORY_MB=256

# Global defaults for orchestration (overridable per provider in the UI)
CONCILIUM_DEFAULT_CONCURRENCY=4
CONCILIUM_DEFAULT_MAX_RETRIES=2
CONCILIUM_DEFAULT_COOLDOWN_SECONDS=30
